# Frontend configuration (copy to .env.local, which git ignores). Never commit real secrets.

# Base path of the backend API that services/apiClient.ts calls (proxied in dev by vite.config.ts).
VITE_API_BASE=/api/v1
# Dev proxy target for /api (the running backend).
VITE_API_TARGET=http://localhost:5000
# Path the app is hosted under in production ("/" at the site root, "/myapp/" under a path).
# VITE_BASE=/

# Contact details for the footer, the account menu and About. Leave unset for the placeholders;
# put your own here and restart the dev server. The GitHub value must be an https://github.com/... address.
# VITE_CONTACT_EMAIL=you@example.com
# VITE_CONTACT_PHONE=000-000-0000
# VITE_CONTACT_GITHUB=https://github.com/your-user
